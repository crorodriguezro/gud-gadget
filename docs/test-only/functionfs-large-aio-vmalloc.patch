 	if (io_data->read && _ep->address == 1 && req->length == 12800)
 		pr_info("gud_ffs_trace event=ffs_complete_wake ts_ns=%llu req=%px io_data=%px ep=%px req_actual=%u req_status=%d io_status=%d\n",
 			(unsigned long long)ktime_get_ns(), req, io_data, _ep,
@@ -845,6 +893,24 @@
 static inline void *ffs_alloc_buffer(struct ffs_io_data *io_data,
 	size_t data_len)
 {
+	if (io_data->use_chunks) {
+		io_data->chunk_buf = kmalloc(min_t(size_t, data_len,
+						   FFS_CHUNK_SIZE), GFP_KERNEL);
+		if (!io_data->chunk_buf)
+			return NULL;
+
+		io_data->transfer_len = data_len;
+		io_data->chunk_offset = 0;
+		io_data->chunk_len = min_t(size_t, data_len, FFS_CHUNK_SIZE);
+		io_data->buf = vmalloc(data_len);
+		if (!io_data->buf) {
+			kfree(io_data->chunk_buf);
+			io_data->chunk_buf = NULL;
+			return NULL;
+		}
+		return io_data->buf;
+	}
+
 	if (io_data->use_sg)
 		return ffs_build_sg_list(&io_data->sgt, data_len);
 
