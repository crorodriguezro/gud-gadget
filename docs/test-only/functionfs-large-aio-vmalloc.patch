 static void ffs_epfile_io_complete(struct usb_ep *_ep, struct usb_request *req)
 {
 	struct ffs_io_data *io_data = req->context;
+	unsigned long flags;
+	int ret;
+
+	if (io_data->use_chunks) {
+		if (req->status) {
+			io_data->status = req->status;
+		} else if (req->actual > io_data->chunk_len) {
+			io_data->status = -EIO;
+		} else {
+			if (io_data->read && req->actual)
+				memcpy(io_data->buf + io_data->chunk_offset,
+				       io_data->chunk_buf, req->actual);
+			io_data->chunk_offset += req->actual;
+			io_data->status = io_data->chunk_offset;
+
+			if (req->actual == req->length &&
+			    io_data->chunk_offset < io_data->transfer_len) {
+				/* Keep one logical FunctionFS I/O while using bounded
+				 * contiguous DMA buffers underneath it. */
+				io_data->chunk_len = min_t(size_t,
+					io_data->transfer_len - io_data->chunk_offset,
+					FFS_CHUNK_SIZE);
+				if (!io_data->read)
+					memcpy(io_data->chunk_buf,
+					       io_data->buf + io_data->chunk_offset,
+					       io_data->chunk_len);
+				req->buf = io_data->chunk_buf;
+				req->sg = NULL;
+				req->num_sgs = 0;
+				req->length = io_data->chunk_len;
+
+				spin_lock_irqsave(&io_data->ffs->eps_lock, flags);
+				if (io_data->epfile->ep &&
+				    io_data->epfile->ep->ep == _ep)
+					ret = usb_ep_queue(_ep, req, GFP_ATOMIC);
+				else
+					ret = -ESHUTDOWN;
+				spin_unlock_irqrestore(&io_data->ffs->eps_lock, flags);
+				if (!ret)
+					return;
+				io_data->status = ret;
+			}
+		}
+	} else {
+		io_data->status = req->status ? req->status : req->actual;
+	}
 
 	if (io_data->read && _ep->address == 1 && req->length == 12800)
 		pr_info("gud_ffs_trace event=ffs_complete_enter ts_ns=%llu req=%px io_data=%px ep=%px ep_name=%s ep_num=%u req_length=%u req_actual=%u req_status=%d io_status_before=%d cpu=%u\n",
@@ -747,11 +800,6 @@
 			_ep->name, _ep->address, req->length, req->actual,
 			req->status, READ_ONCE(io_data->status), raw_smp_processor_id());
 
-	if (req->status)
-		io_data->status = req->status;
-	else
-		io_data->status = req->actual;
